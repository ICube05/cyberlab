{
  "name": "cyberlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CyberLab — an interactive cybersecurity & ethical hacking learning environment that feels like an IDE.",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @cyberlab/server dev",
    "dev:web": "pnpm --filter @cyberlab/web dev",
    "build": "pnpm --filter @cyberlab/web build",
    "start": "pnpm --filter @cyberlab/server start",
    "preview": "pnpm --filter @cyberlab/web preview",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @cyberlab/server e2e",
    "progress:save": "node scripts/progress.mjs",
    "clean": "rm -rf node_modules **/node_modules **/dist **/.tsbuildinfo apps/server/data"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
