# ─────────────────────────────────────────────────────────────────────────────
# CyberLab configuration.
#
# Copy this file to `.env` IN THIS DIRECTORY (the workspace root) and edit it.
# The server resolves .env against the workspace root, so it is found whether
# you run `pnpm dev` from here or a script from inside apps/server.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI tutor ────────────────────────────────────────────────────────────────
# ollama | gemini | offline
# "offline" is not a failure mode: the tutor answers from the lesson's authored
# pedagogy. Set a provider to get a real model.
AI_PROVIDER=offline

# Gemini — get a key at https://aistudio.google.com/apikey
# AI_PROVIDER=gemini ALONE IS NOT ENOUGH: without a key the server falls back
# to the offline tutor and says so at boot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama — a local model, no key, nothing leaves your machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1400
AI_TIMEOUT_MS=90000

# ── Labs ────────────────────────────────────────────────────────────────────
# inproc (default, zero setup) | docker
LAB_RUNTIME=inproc

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5174
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
CONTENT_LOCALE=it
