# ─────────────────────────────────────────────────────────────
# CyberLab — configurazione
#
# Copia questo file in `.env` NELLA RADICE DEL WORKSPACE
# (accanto a pnpm-workspace.yaml). Tutto ha un default sensato:
# con un .env vuoto la piattaforma parte lo stesso.
#
# Ordine di caricamento: <root>/.env → <root>/.env.local → ./.env
# Le variabili già presenti nell'ambiente vincono sempre sul file.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=5174
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173

# Database dei progressi (SQLite). Relativo = risolto sulla radice
# del workspace, non sulla cwd. Usa :memory: per non salvare nulla.
CYBERLAB_DB=./apps/server/data/cyberlab.db

# ── Tutor AI ─────────────────────────────────────────────────
# offline | gemini | ollama
# "offline" NON è un guasto: è un tutor deterministico che risponde
# dalla pedagogia autoriale della lezione. Lezioni, lab e sfide
# funzionano comunque.
AI_PROVIDER=offline

# Gemini — chiave obbligatoria, altrimenti si ricade su offline con
# un avviso esplicito all'avvio. Chiave: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Ollama — locale, nessuna chiave
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_KEEP_ALIVE=10m

# Generazione
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1400
AI_TIMEOUT_MS=90000

# ── Laboratori ───────────────────────────────────────────────
# inproc = sandbox in-process, nessun setup (default)
# docker = adattatore Docker
LAB_RUNTIME=inproc
LAB_MAX_INSTANCES=6
LAB_IDLE_TTL_MS=1800000
LAB_ACTION_TIMEOUT_MS=4000

# Solo con LAB_RUNTIME=docker
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_LAB_NETWORK=cyberlab-internal
DOCKER_MEMORY_MB=512
DOCKER_CPU_SHARES=512

# ── Contenuti ────────────────────────────────────────────────
CONTENT_LOCALE=it
